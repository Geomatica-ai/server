# Environment variables for development docker-compose.dev.yml

FLASK_DEBUG=1

# Bind gunicorn to all interfaces so nginx can reach it
GUNICORN_CMD_ARGS=--bind 0.0.0.0:5000

# Mail SMTP connection to maildev

MAIL_SERVER=maildev
MAIL_PORT=1025
MAIL_SUPPRESS_SEND=0
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_DEFAULT_SENDER=noreply@example.com
